# Minimum runtime
POSTGRES_URL=
BETTER_AUTH_SECRET=

# Vercel OAuth (sign-in option; also unlocks Vercel project sync + previews)
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# GitHub App (repo access, pushes, PRs — and "Continue with GitHub" sign-in)
# Callback URL: {YOUR_ORIGIN}/api/auth/callback/github (better-auth)
# Setup URL:    {YOUR_ORIGIN}/api/github/app/callback (installation sync)
# In the GitHub App settings:
#   1. Use the GitHub App Client ID and Client Secret below
#   2. Make the app public if you want org installs to work cleanly
#   3. Store the private key either as PEM contents with escaped newlines
#      or as a base64-encoded PEM
#   4. For "Continue with GitHub" sign-in, set Permissions > Account
#      permissions > "Email addresses" to Read-only so new users get an email.
# Each user links their own GitHub account and installs the app on the
# accounts/orgs they choose, so repo access is scoped per user.
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
NEXT_PUBLIC_GITHUB_APP_SLUG=
# Optional runtime override for the slug (read at request time, not build time)
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# Optional integrations
ELEVENLABS_API_KEY=
# Tavily web search for the agent's web_search tool (https://app.tavily.com).
# Called server-side only; the key never enters the sandbox.
TAVILY_API_KEY=

# Optional Redis / Vercel KV (skills metadata cache; falls back to in-memory when not set)
REDIS_URL=
KV_URL=

# Optional private Vercel Blob store for the design subagent's screenshot gallery.
# Connecting a Blob store in Vercel sets these; set either one. Without one,
# galleries still list captures and errors, but no images are kept.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Optional deployment refinements
# Set to "hobby" to use lower resource defaults for constrained deployments.
# Leave unset for standard behavior.
OPEN_AGENTS_RESOURCE_PROFILE=
VERCEL_PROJECT_PRODUCTION_URL=
NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL=
# Optional base snapshot for fresh sandboxes. If unset, sandboxes use Vercel's standard Sandbox runtime.
# Use a snapshot created in/accessible to your own Vercel scope.
VERCEL_SANDBOX_BASE_SNAPSHOT_ID=
